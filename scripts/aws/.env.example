# Description: Example of .env file
# Usage: Copy this file to .env and change the values
#        according to your needs
#        Do not commit .env file to git
#        Do not change .env.example file
# 　　　 You must set a superuser's username and password.
#        LANGFLOW_SUPERUSER and LANGFLOW_SUPERUSER_PASSWORD are required;
#        the application will fail to start without them.

LANGFLOW_SUPERUSER=admin
LANGFLOW_SUPERUSER_PASSWORD=123456
